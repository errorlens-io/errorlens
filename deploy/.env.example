# Copy to deploy/.env and change the password.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
ROOTCAUSE_PUBLIC_URL=http://localhost:8080
ROOTCAUSE_PORT=8080

# Optional: encrypt stored events. Generate with `openssl rand -base64 32`
# and keep a backup — losing it makes encrypted events unreadable.
ROOTCAUSE_ENCRYPTION_KEY=

# Optional: outgoing email for alerts, invitations and password resets.
ROOTCAUSE_SMTP_HOST=
ROOTCAUSE_SMTP_PORT=587
ROOTCAUSE_SMTP_USERNAME=
ROOTCAUSE_SMTP_PASSWORD=
ROOTCAUSE_SMTP_FROM=RootCause <alerts@example.com>
