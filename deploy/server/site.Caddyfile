# Serves the static website (Next.js export) inside the errorlens-site container.
{
	admin off
	auto_https off
}

:80 {
	root * /srv/site
	encode zstd gzip

	# Next.js fingerprints everything under /_next/static; the HTML must stay fresh.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@assets path /screenshots/* /favicon.svg /apple-touch-icon.png /og.png
	header @assets Cache-Control "public, max-age=604800"
	@meta path /robots.txt /sitemap.xml /llms.txt
	header @meta Cache-Control "public, max-age=3600"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
	@html path / *.html */
	header @html Cache-Control "public, max-age=0, must-revalidate"

	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
