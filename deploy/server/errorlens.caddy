# ErrorLens — imported by the edge Caddy through `import /config/*.caddy`.
# The edge Caddy reads this only at start: after changing it, restart that
# container (a ~1.5 s blip for every site it serves).
#
# errorlens.io is proxied by Cloudflare. Requests that come from Cloudflare's
# ranges carry the visitor's address in CF-Connecting-IP; only those are trusted
# with it, so a request sent straight to the server cannot claim another IP.
# Ranges: https://www.cloudflare.com/ips/ (update if Cloudflare adds any).

(errorlens_upstream) {
	dynamic a {
		name errorlens
		port 8080
		refresh 5s
	}
	lb_try_duration 15s
	lb_try_interval 250ms
}

(errorlens_site) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	encode zstd gzip
	# Source-map uploads are the largest requests.
	request_body {
		max_size 50MB
	}

	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @cloudflare {
		reverse_proxy {
			import errorlens_upstream
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy {
			import errorlens_upstream
		}
	}
}

www.errorlens.io {
	redir https://errorlens.io{uri} permanent
}

errorlens.io {
	import errorlens_site
}
