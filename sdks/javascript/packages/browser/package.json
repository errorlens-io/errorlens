{
  "name": "@errorlens/browser",
  "version": "0.1.0",
  "description": "Browser SDK for ErrorLens, the open-source, self-hosted error tracker.",
  "license": "MIT",
  "homepage": "https://errorlens.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errorlens-io/errorlens.git",
    "directory": "sdks/javascript/packages/browser"
  },
  "keywords": [
    "errorlens",
    "error tracking",
    "exceptions",
    "monitoring"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs dist"
  },
  "dependencies": {
    "@sentry/browser": "^11.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/errorlens-io/errorlens/issues"
  }
}
